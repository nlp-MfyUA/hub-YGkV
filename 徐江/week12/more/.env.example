# Provider 选择：deepseek | qwen
VISION_PROVIDER=deepseek

# DeepSeek（主通道；base_url 按你的服务商文档填写）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=deepseek-v4.1-flash

# Qwen（备选通道，DashScope compatible-mode）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-vl-max

# 通用
MAX_IMAGE_MB=8
MIN_IMAGE_SIDE=224
TIMEOUT_S=30
MAX_RETRIES=1
LOG_LEVEL=INFO
# 演示令牌：留空表示不校验；设置后 /api/analyze 需带请求头 X-Demo-Token
DEMO_TOKEN=
