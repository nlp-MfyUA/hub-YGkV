# 复制为 .env 后按需修改；本文件不含任何真实密钥。
# 真实 .env 请参照 week12/ChatBI-LangChain/.env（BASE_URL / API_KEY 同一网关）。

# ---- 模型网关 ----
BASE_URL=http://127.0.0.1:7863/v1
API_KEY=
MODEL_NAME=cn:deepseek-v4.1-flash
CHECK_FALLBACK_MODEL=cn:minimax-m3.1-flash
CHECK_TIMEOUT_SECONDS=15
LLM_TIMEOUT_SECONDS=120

# ---- 数据库 ----
DB_FILE_PATH=./db/chinook.db

# ---- 流程约束 ----
MAX_REVIEW_ROUNDS=3

# ---- 执行约束 ----
MAX_RESULT_ROWS=200
QUERY_TIMEOUT_SECONDS=5
MAX_SQL_LENGTH=8000

# ---- 对话 ----
MAX_HISTORY_TURNS=3

# ---- 服务 ----
HOST=127.0.0.1
PORT=8613
