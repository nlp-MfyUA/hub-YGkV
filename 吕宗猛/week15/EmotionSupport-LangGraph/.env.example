# Magpie 本地模型网关（OpenAI 兼容）
BASE_URL=http://127.0.0.1:3425/v1
API_KEY=
MODEL_NAME=workbuddy/deepseek-v4.1-flash
EMOTION_MODEL=workbuddy/deepseek-v4.1-flash
REPLY_MODEL=workbuddy/deepseek-v4.1-flash

# 0 = 真实模型；1 = 离线规则模拟
MOCK_MODE=0

# 后端进程
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8622

# 前端进程
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=8612
BACKEND_URL=http://127.0.0.1:8622

# 对话上下文轮数
MAX_HISTORY_ROUNDS=5
