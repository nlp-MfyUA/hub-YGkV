# 复制为 deploy/.env 并填写真实值
MYSQL_HOST=rag-mysql
MYSQL_PORT=3306
MYSQL_USER=rag_mm
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DATABASE=rag_mm

KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=mm.pdf.parse
KAFKA_GROUP=mm-rag-worker

MINERU_URL=http://mineru:8003
MINERU_TIER=basic
MINERU_TIMEOUT=1800

MODEL_SERVICE_URL=http://rag-models:8901
MODEL_SERVICE_API_KEY=dev-model-key
EMBEDDING_MODEL=bge-small-zh-v1.5

MAGPIE_BASE_URL=http://192.168.124.88:3425/v1
MAGPIE_API_KEY=CHANGE_ME
MAGPIE_MODEL=workbuddy/deepseek-v4.1-flash

DATA_DIR=/data
CHAT_TOP_K=6
CHAT_CONTEXT_MAX_CHUNKS=8
