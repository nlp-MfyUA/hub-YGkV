# 示例配置：复制为本地环境配置并替换，绝不上传真实密钥。
OPENAI_API_KEY=在这里填写自己的DeepSeek_API_Key
OPENAI_BASE_URL=https://api.deepseek.com
SQL_AGENT_MODEL=deepseek-flash
SQL_AGENT_SUMMARY_MODEL=deepseek-flash
SQL_AGENT_MAX_REPAIR_ATTEMPTS=3
SQL_AGENT_MAX_ROWS=200
SQL_AGENT_MAX_SUMMARY_ROWS=50
SQL_AGENT_QUERY_TIMEOUT=5
SQL_AGENT_LOG_LEVEL=INFO
