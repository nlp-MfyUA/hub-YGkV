# 复制为 .env 并填入你自己的 Key（.env 已被 gitignore，不会提交）

# --- 大模型（OpenAI 兼容协议，任选一家，改这里即可切换模型）---
# DeepSeek
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 通用 OpenAI 兼容变量（若设置，优先于上面 DEEPSEEK_*）
# LLM_API_KEY=sk-xxxx
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   # Qwen 示例
# LLM_MODEL=qwen-plus
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4               # Zhipu GLM 示例
# LLM_MODEL=glm-4-plus

# --- 博查 Web 搜索 ---
BOCHA_API_KEY=sk-xxxx
