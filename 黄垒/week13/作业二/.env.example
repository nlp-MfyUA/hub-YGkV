# 复制为 .env，填入自己的 Key（.env 已被 gitignore，不会提交）

# --- 大模型（OpenAI 兼容协议，任选一家）---
# DeepSeek
LLM_API_KEY=sk-xxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 阿里百炼 Qwen
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-max

# 智谱 GLM
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-plus

# --- 服务配置（都有默认值，按需修改）---
# HOST=0.0.0.0
# PORT=8000
# DB_PATH=../作业一/chinook.db
# MAX_CONCURRENCY=4

# --- 演示用：每次第一次生成时故意写错字段，展示「校验 -> 改写」循环 ---
# INJECT_BAD_SQL=1
